{
  "expo": {
    "name": "Despensa em Dia",
    "slug": "despensa-em-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.despensaemdia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.despensaemdia"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Despensa em Dia",
      "themeColor": "#2E7D4F"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "O Despensa em Dia usa a câmera para ler o código de barras e a data de validade das embalagens.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar"
    ],
    "scheme": "despensaemdia",
    "experiments": {
      "typedRoutes": true
    }
  }
}
